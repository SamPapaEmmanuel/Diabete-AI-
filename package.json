{
  "name": "diabetes-report-interpreter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "db:local": "node scripts/local-postgres.mjs",
    "api:dev": "uv run --project apps/api uvicorn report_api.app:app --host 127.0.0.1 --port 8000 --no-access-log --no-server-header",
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "eslint apps/web scripts/*.mjs tests/browser playwright.config.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace apps/web && tsc -p tsconfig.json",
    "test": "npm run test --workspace apps/web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
